# This file is a template for your .env file.
# Copy this file to .env and fill in the values for your desired environment.

# --- General Settings ---
# APP_ENV can be "DEV" or "DEMO" and is used for environment-specific logic.
APP_ENV="DEV"

# --------------------------------------------------------------------------------
# --- OPTION 1: Configuration for Local Ollama (DEV) ---
# --------------------------------------------------------------------------------
# Uncomment the following lines to use your local Ollama setup.

LLM_BASE_URL="http://localhost:11434/v1"
LLM_API_KEY="ollama" # This is a required placeholder for the OpenAI client

# --- Model names should match what you have pulled with `ollama pull <model_name>` ---
LLM_EMBEDDING_MODEL="nomic-embed-text"
LLM_FAST_MODEL="mistral:7b"
LLM_THINKING_MODEL="deepseek-r1:8b"


# --------------------------------------------------------------------------------
# --- OPTION 2: Configuration for OpenRouter (DEMO) ---
# --------------------------------------------------------------------------------
# Uncomment the following lines to use the OpenRouter service.
# Make sure to set your APP_ENV to "DEMO".

# LLM_BASE_URL="https://openrouter.ai/api/v1"
# LLM_API_KEY="your_openrouter_api_key_here"

# --- Model names from OpenRouter ---
# LLM_EMBEDDING_MODEL="nomic-ai/nomic-embed-text-v1.5"
# LLM_FAST_MODEL="mistralai/mistral-7b-instruct"
# LLM_THINKING_MODEL="openai/gpt-4o"


# --- Observability Settings ---
# LangSmith Configuration for Observability
LANGCHAIN_TRACING_V2="true"
LANGCHAIN_API_KEY="your_langsmith_api_key_here"
LANGCHAIN_PROJECT="your_langsmith_project_name_here" # Project name in LangSmith