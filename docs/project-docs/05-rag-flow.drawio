        <mxCell id="prompt-text" value="You are analyzing medical research on: GIST prevention&#xa;&#xa;Based on these research papers:&#xa;[Doc A] Title: ... Abstract: ... Key Findings: ...&#xa;[Doc B] Title: ... Abstract: ... Key Findings: ...&#xa;... (20 documents) ...&#xa;&#xa;Question: What are the potential preventative factors for GIST?&#xa;Provide evidence-based analysis with citations." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="140" y="810" width="1020" height="80" as="geometry" />
        </mxCell>
        
        <mxCell id="step5" value="STEP 5: LLM Generation" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1" vertex="1" parent="1">
