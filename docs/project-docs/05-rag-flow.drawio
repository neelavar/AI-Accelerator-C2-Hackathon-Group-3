        <mxCell id="step4" value="STEP 4: Augment Prompt with Context" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="100" y="730" width="1100" height="30" as="geometry" />
