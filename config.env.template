# MediScout Configuration
# Copy this file to .env and fill in your values

# ============================================================================
# LLM Provider (OpenRouter - User provides key)
# ============================================================================
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_key_here

# Optional: Specify default model (free models recommended)
# Options: meta-llama/llama-3.1-70b-instruct, google/gemma-2-9b-it
OPENROUTER_MODEL=meta-llama/llama-3.1-70b-instruct:free

# ============================================================================
# LangSmith (Optional - for tracing and debugging)
# ============================================================================
# Get your key at: https://smith.langchain.com/
LANGSMITH_API_KEY=your_langsmith_key_here
LANGSMITH_PROJECT=mediscout-dev
LANGSMITH_TRACING=false  # Set to 'true' to enable

# ============================================================================
# Vector Database (ChromaDB - Local, no key needed)
# ============================================================================
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=mediscout_docs

# ============================================================================
# Embedding Model (Local - no key needed)
# ============================================================================
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu  # or 'cuda' if GPU available
EMBEDDING_BATCH_SIZE=32

# ============================================================================
# External APIs (Free - no keys required)
# ============================================================================
# PubMed API (via Biopython)
PUBMED_EMAIL=your_email@example.com  # Required by NCBI
PUBMED_MAX_RESULTS=10

# ClinicalTrials.gov API
CLINICALTRIALS_MAX_RESULTS=5

# ============================================================================
# Optional: Google Scholar via SerpAPI ($0.05/search)
# ============================================================================
# SERPAPI_KEY=your_serpapi_key_here
# SERPAPI_MAX_RESULTS=5

# ============================================================================
# Application Settings
# ============================================================================
# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR
LOG_FILE=./logs/mediscout.log

# Document Processing
CHUNK_SIZE=500
CHUNK_OVERLAP=100
MAX_DOCUMENT_SIZE_MB=50

# RAG Settings
TOP_K_RESULTS=20
SIMILARITY_THRESHOLD=0.4
RERANK_ENABLED=true

# LLM Settings
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4000
LLM_TIMEOUT_SECONDS=30

